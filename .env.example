# Environment template for the remote helpers.
# Copy to .env and set values, or export these directly. Never commit .env.

# SSH target that runs the Hygon DCU box.
# Either a real hostname or a Host alias from ~/.ssh/config (preferred).
MOSS_HOST=
MOSS_PORT=22
MOSS_USER=

# Optional. Leave empty to use key-based auth / ssh agent (recommended).
# If set, it must point at a mode-600 file containing only the password.
MOSS_PASS_FILE=

# Local:remote port pairs forwarded by tools/remote_tunnel.py
MOSS_FORWARDS=8081:8081

# Model locations on the remote machine (override the defaults in ui_server.py)
MOSS_IMAGE_MODEL=/workspace/models/MOSS-Image-SFT
QWEN_IMAGE_MODEL=/workspace/models/Qwen-Image-2.1

# Where the UI writes generated PNGs and metadata
GI_OUT=/workspace/bench/gallery
GI_PORT=8081
